# CognoDB Cloud connection details (console.cognodb.com -> your instance).
# The password is shown exactly once at instance creation. Never commit .env.local.
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Optional: cap the pool. The free c0 tier allows 200 connections in total.
COGNODB_MAX_POOL_SIZE=10
