# Base URL of the FastAPI backend.
#
# This is a NEXT_PUBLIC_ variable in a statically exported app, so its value is
# BAKED IN AT BUILD TIME. Changing the backend URL means rebuilding and
# redeploying the frontend -- setting it in Vercel after a build has no effect
# until the next deploy.
#
# Local development (uvicorn on :8000, next dev on :3000):
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Production example (set this one in the Vercel project settings):
# NEXT_PUBLIC_API_BASE=https://grid-contingency-api.onrender.com
